diff --git a/packages/SettingsLib/src/com/android/settingslib/graph/OneUI7BatteryDrawable.java b/packages/SettingsLib/src/com/android/settingslib/graph/OneUI7BatteryDrawable.java
new file mode 100644
--- /dev/null
+++ b/packages/SettingsLib/src/com/android/settingslib/graph/OneUI7BatteryDrawable.java
@@ -0,0 +1,56 @@
+package com.android.settingslib.graph;
+
+import android.content.Context;
+import android.content.res.Resources;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+
+import com.android.settingslib.graph.BatteryDrawable;
+import com.android.settingslib.R;
+
+public class OneUI7BatteryDrawable extends BatteryDrawable {
+
+    private final Path mOutlinePath = new Path();
+    private final Path mFillPath = new Path();
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private int mLevel = 100;
+
+    public OneUI7BatteryDrawable(Context context, int frameColor) {
+        super(context, frameColor);
+        Resources res = context.getResources();
+        mOutlinePath.addPath(PathParser.createPathFromPathData(
+                res.getString(R.string.config_battery_path_oneui7_outline)));
+        mFillPath.addPath(PathParser.createPathFromPathData(
+                res.getString(R.string.config_battery_path_oneui7_fill)));
+    }
+
+    @Override
+    public void draw(Canvas canvas) {
+        RectF bounds = new RectF(getBounds());
+        canvas.save();
+        canvas.scale(bounds.width() / 24f, bounds.height() / 24f);
+
+        mPaint.setStyle(Paint.Style.STROKE);
+        mPaint.setStrokeWidth(1.5f);
+        mPaint.setColor(mFrameColor);
+        canvas.drawPath(mOutlinePath, mPaint);
+
+        float fillFraction = mLevel / 100f;
+        canvas.clipRect(0, (1 - fillFraction) * 24f, 24f, 24f);
+
+        mPaint.setStyle(Paint.Style.FILL);
+        mPaint.setColor(mFillColor);
+        canvas.drawPath(mFillPath, mPaint);
+
+        canvas.restore();
+    }
+
+    @Override
+    public void setBatteryLevel(int level) {
+        mLevel = level;
+        invalidateSelf();
+    }
+}
